# ========== OpenAI (required for RAG embeddings + chat fallback) ==========
OPENAI_API_KEY=your_openai_api_key_here

# Optional: override the default chat model (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# ========== ElevenLabs (required for voice) ==========
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here
# Optional: default agent ID used by the backend token endpoint
# ELEVENLABS_AGENT_ID=your_agent_id_here

# ========== Vite (frontend — restart dev server after changes) ==========
VITE_ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id_here
# true = private agent (uses signed URL via backend). false = public agent (direct connection)
VITE_ELEVENLABS_USE_CONV_TOKEN=true

# ========== Supabase (required for database + vector store) ==========
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ========== Optional ==========
# Webhook secret for the ElevenLabs agent tool (leave blank to skip auth)
LUMEN_AGENT_WEBHOOK_SECRET=
# Backend port (default: 3001)
# PORT=3001
